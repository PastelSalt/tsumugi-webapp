# Copy to .env (optional). Everything has a local default.
PORT=3001
# Leave empty to use the built-in local database stored in Server/.data (started automatically by `npm run dev`).
# Or point to a MongoDB you installed yourself, e.g. mongodb://127.0.0.1:27017/tsumugi
MONGODB_URI=
# Where uploaded files are stored on this PC
UPLOAD_DIR=./uploads
# Allowed browser origin for the Vite dev server
CLIENT_ORIGIN=http://localhost:5173
SESSION_DAYS=30
