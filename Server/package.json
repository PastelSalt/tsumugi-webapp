{
  "name": "tsumugi-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tsumugi API (MVP): Express, MongoDB, local-first",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node src/server.js",
    "dev:watch": "node --watch src/server.js",
