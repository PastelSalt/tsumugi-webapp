    {
      "id": "6afac1f3f17f6280b0c116bb",
      "projectId": "6afac1f3f17f6280b0c11689",
      "name": "Chapter one script",
      "kind": "document",
      "ext": "md",
      "bytes": 144,
      "tags": [
        "script"
      ],
      "description": "The chapter one script, in progress.",
      "status": "Draft",
      "version": 1,
      "body": "# Chapter one script\n\n## Scene one\nThe garden gate is open. Someone has been here before.\n\n## Scene two\nA quiet conversation that sets the tone.",
      "isDoc": true,
      "isFinal": false,
      "requirementIds": [
        "6afac1f3f17f6280b0c116a7",
        "6afac1f3f17f6280b0c116a8"
