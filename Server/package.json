    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
